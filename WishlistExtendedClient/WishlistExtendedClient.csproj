<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>WishlistExtended</RootNamespace>
    <Title>Wishlist Extended</Title>
    <Authors>ZGFueDkx</Authors>
    <AssemblyName>WishlistExtended-Client</AssemblyName>
    <AssemblyVersion>1.2.0</AssemblyVersion>
    <Version>$(AssemblyVersion)</Version>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Copyright>Copyright © 2026 $(Authors)</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Fork: TarkovDir comes from the .csproj.user next to this file (not committed).
       Deploys the plugin DLL + locales; .orig = first DLL ever replaced, .bak = previous deploy. -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(DeployToGame)' != 'false' And '$(TarkovDir)' != ''">
    <PropertyGroup><PluginDeployDir>$(TarkovDir)BepInEx\plugins\WishlistExtended\</PluginDeployDir></PropertyGroup>
    <ItemGroup><OutputDLL Include="$(TargetPath)" /></ItemGroup>
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(PluginDeployDir)$(TargetFileName)" DestinationFiles="$(PluginDeployDir)$(TargetFileName).orig"
          Condition="Exists('$(PluginDeployDir)$(TargetFileName)') And !Exists('$(PluginDeployDir)$(TargetFileName).orig')" />
    <Delete Files="$(PluginDeployDir)$(TargetFileName).bak" ContinueOnError="true" />
    <Move SourceFiles="$(PluginDeployDir)$(TargetFileName)" DestinationFiles="$(PluginDeployDir)$(TargetFileName).bak"
          Condition="Exists('$(PluginDeployDir)$(TargetFileName)')" />
    <Copy SourceFiles="@(OutputDLL)" DestinationFolder="$(PluginDeployDir)" />
    <ItemGroup><LocaleFiles Include="$(ProjectDir)locales\*.json" /></ItemGroup>
    <Copy SourceFiles="@(LocaleFiles)" DestinationFolder="$(PluginDeployDir)locales" />
  </Target>

  <ItemGroup>
    <Compile Include="../../ZGFueDkxCommonLibrary/**/*.cs" Exclude="../../ZGFueDkxCommonLibrary/obj/**;../../ZGFueDkxCommonLibrary/bin/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(TarkovDir)BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(TarkovDir)BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
    </Reference>
    <Reference Include="Comfort.Unity">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\Comfort.Unity.dll</HintPath>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\ItemComponent.Types.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(TarkovDir)BepInEx\plugins\spt\spt-common.dll</HintPath>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(TarkovDir)BepInEx\plugins\spt\spt-reflection.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
